<Window x:Class="ПрактическаяРаботаWPF12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-ПрактическаяРаботаWPF12"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Sas"
                Text="Покраска фигур!!!" 
                       HorizontalAlignment="Center"
                       FontSize="30" 
                       FontWeight="Bold"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Rows="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle x:Name="Priamougol" Width="180" Height="80"
                           Stroke="DarkViolet" StrokeThickness="5"
                           Fill="White"
                           MouseDown="Shape_Click"/>
                
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle x:Name="Kvadrat" Width="80" Height="80"
                           Stroke="DarkViolet" StrokeThickness="5"
                           Fill="White"
                           MouseDown="Shape_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="oval" Width="180" Height="80"
                         Stroke="DarkViolet" StrokeThickness="5"
                         Fill="White"
                         MouseDown="Shape_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="krug" Width="80" Height="80"
                         Stroke="DarkViolet" StrokeThickness="5"
                         Fill="White"
                         MouseDown="Shape_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="primoy2" Width="180" Height="80"
                        BorderBrush="DarkViolet" BorderThickness="5"
                        Background="White"
                        MouseDown="Shape_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="kv2" Width="80" Height="80"
                        BorderBrush="DarkViolet" BorderThickness="5"
                        Background="White"
                        MouseDown="Shape_Click"/>
            </StackPanel>
        </UniformGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Background="DarkOrange" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Red" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Yellow" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Black" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Wheat" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="White" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Blue" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Pink" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="Purple" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="NavajoWhite" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
            <Button Background="DarkBlue" Width="40" Height="40" Margin="5"
                    PreviewMouseLeftButtonDown="Color_Left"
                    PreviewMouseRightButtonDown="Color_Right"/>
        </WrapPanel>


    </Grid>
</Window>