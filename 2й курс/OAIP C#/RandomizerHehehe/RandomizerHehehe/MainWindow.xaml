<Window x:Class="RandomizerHehehe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RandomizerHehehe"
        mc:Ignorable="d"
        Title="Да" Height="450" Width="800" KeyDown="Window_KeyDown">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="Black" Offset="1"/>
                <GradientStop Color="#FFEDC400" Offset="0.444"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="102*"></RowDefinition>
            <RowDefinition Height="187*"></RowDefinition>
            <RowDefinition Height="145*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock  Grid.Column="1" HorizontalAlignment="Center" Margin="0,1,0,0" TextWrapping="Wrap" Text="Randomaiz!" TextAlignment="Center" VerticalAlignment="Top" Width="192" Background="{x:Null}" Foreground="#FFEDC400" Height="36" FontFamily="Bradley Hand ITC" FontSize="24" />

        <Border Grid.Column="1" BorderBrush="Black"   BorderThickness="1" HorizontalAlignment="Left" Height="28"  VerticalAlignment="Top" Width="185" CornerRadius="10" Margin="19,50,0,0">
            <TextBox x:Name="input" TextWrapping="Wrap" Text="Введи суда элемент списка)" Margin="10,2,-1,1" Foreground="#FF5AFF00" Background="{x:Null}" SelectionBrush="{x:Null}" SelectionTextBrush="{x:Null}" BorderBrush="{x:Null}" TextChanged="input_TextChanged"/>
        </Border>
        <Border  Grid.Column="1" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Top" Width="41" CornerRadius="10" Margin="204,50,0,0" >
            <Button Content="Add" HorizontalAlignment="Center"  VerticalAlignment="Center" Height="26" Width="33" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FFFFEA00" Click="Button_Click"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="Black" BorderThickness="1" CornerRadius="10" >
            <ListBox BorderBrush="{x:Null}" Background="{x:Null}" Foreground="#FF5AFF00" x:Name="megalist" />
        </Border>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" TextWrapping="Wrap" Text="Выберите рандомное значение↓" TextAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Height="48" Width="247" Foreground="#FF42FF00" FontFamily="Comic Sans MS" FontSize="18"/>

        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Center" Height="35" Margin="0,73,0,0" Grid.Row="2" VerticalAlignment="Top" Width="164" CornerRadius="10">
            <Button  Content="Рандомчик😊" HorizontalAlignment="Center"  VerticalAlignment="Center" Height="40" RenderTransformOrigin="0.5,0.5" Width="164" Background="{x:Null}"  BorderBrush="{x:Null}" FontFamily="Comic Sans MS" FontSize="22" Foreground="#FF37FF00"/>
        </Border >







    </Grid>
</Window>
