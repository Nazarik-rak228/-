@model IhateThisErrorsAndBug.Models.OrderItem

<h2>Добавить предмет заказа</h2>

<form method="post">
    <label>Order ID</label>
    <input type="number" asp-for="OrderId" />
    <span asp-validation-for="OrderId" class="text-danger"></span>

    <label>Product ID</label>
    <input type="number" asp-for="ProductId" />
    <span asp-validation-for="ProductId" class="text-danger"></span>

    <label>Количество</label>
    <input type="number" asp-for="Quantity" />
    <span asp-validation-for="Quantity" class="text-danger"></span>

    <label>Цена</label>
    <input type="number" step="1.0" asp-for="PriceAtPurchase" />
    <span asp-validation-for="PriceAtPurchase" class="text-danger"></span>

    <button type="submit">Добавить</button>
</form>