@model IhateThisErrorsAndBug.Models.CartItem

<h2>Изменить предмет корзины</h2>

<form method="post">
    <input type="hidden" asp-for="CartItemId"/>

    <label>Cart ID</label>
    <input type="number" asp-for="CartId"/>
    <span asp-validation-for="CartId" class="text-danger"></span>

    <label>Product ID</label>
    <input type="number" asp-for="ProductId" />
    <span asp-validation-for="ProductId" class="text-danger"></span>

    <label>Количество</label>
    <input type="number" step="1.0" asp-for="Quantity" />
    <span asp-validation-for="Quantity" class="text-danger"></span>
    
    <button type="submit">Сохранить</button>
</form>