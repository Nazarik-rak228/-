@model IhateThisErrorsAndBug.Models.Product

<h2>Изменить товар</h2>
<img src="@Url.Action("GetImage", "Main", new { productId = Model.ProductId })" width="200" />

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProductId" />

    

    <label>Название</label>
    <input type="text" asp-for="ProductName"/>
    <span asp-validation-for="ProductName" class="text-danger"></span>

    <label>Цена</label>
    <input type="number" step="0.01" asp-for="Price" />
    <span asp-validation-for="Price" class="text-danger"></span>

    <label>Category ID</label>
    <input type="number" asp-for="CategoryId" />
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <label>Описание товара</label>
    <input type="text" asp-for="Discription" class="inputMoreText" />
    <span asp-validation-for="Discription" class="text-danger"></span>
    <label>Новая картинка</label>
    <input type="file" name="ImageFile" accept="image/*" />

    <button type="submit">Сохранить</button>
</form>
<a asp-controller="Admin" asp-action="Index">Назад в админ панель</a>